# Shared secret the booth sends as "Authorization: Bearer <key>".
# Generate one with: openssl rand -hex 32
BOOTH_API_KEY=

# Added by Vercel when a Blob store is connected to the project.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
BLOB_WEBHOOK_PUBLIC_KEY=

# Fallback for running outside Vercel.
BLOB_READ_WRITE_TOKEN=

# Booking requests are emailed through Resend (resend.com).
RESEND_API_KEY=
# Inbox that receives requests.
BOOKING_EMAIL_TO=hello@photobus.ge
# Sender on a domain verified in Resend.
BOOKING_EMAIL_FROM=Photograph <bookings@photobus.ge>
